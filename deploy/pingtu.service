[Unit]
Description=Pingtu AI flat-color converter
After=network.target

[Service]
Type=simple
User=pingtu
Group=pingtu
WorkingDirectory=/opt/pingtu
Environment="PYTHONUNBUFFERED=1"
Environment="TZ=Asia/Shanghai"
ExecStart=/opt/pingtu/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
# 只允许写自己的目录
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
